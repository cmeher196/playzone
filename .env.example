MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cricarena

# Set these in production instead of relying on development defaults.
AUTH_SECRET=replace-with-a-long-random-secret
OTP_SECRET=replace-with-a-long-random-secret
ADMIN_MOBILE=your-admin-mobile
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Administrator

# ---- CricArena / league branding configuration ----
# These NEXT_PUBLIC_* values are exposed to the browser so the payment QR can be
# built on the client. They are not secrets. Copy this file to `.env.local` and
# fill in your real values.

# League name shown in the UI
NEXT_PUBLIC_LEAGUE_NAME=PlaySome
NEXT_PUBLIC_LEAGUE_FULL_NAME=PlaySome

# One-time registration fee (INR)
NEXT_PUBLIC_REG_FEE=300

# UPI account the registration fee is collected to.
# Replace with the organizer's real UPI ID (VPA) and display name.
NEXT_PUBLIC_UPI_ID=your-vpa@bank
NEXT_PUBLIC_UPI_PAYEE_NAME=PlaySome
